{
  "name": "vibe-together-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:production": "node --env-file=.env -e \"process.env.NODE_ENV='production'; import('./src/server.js')\"",
    "admin:credentials": "node scripts/create-admin-credentials.js",
    "admin:provision": "node scripts/provision-admin.js",
    "admin:provision:production": "node --env-file=.env -e \"process.env.NODE_ENV='production'; import('./scripts/provision-admin.js')\"",
    "admin:set-password": "node scripts/set-admin-password.js",
    "bookings:reconcile": "node scripts/reconcile-bookings.js",
    "dev": "node --watch-path=src src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "libphonenumber-js": "^1.13.15",
    "mongoose": "^8.12.1",
    "nodemailer": "^10.3.1",
    "razorpay": "^2.9.8"
  }
}
